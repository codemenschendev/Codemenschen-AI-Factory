APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
REDIS_QUEUE_RETRY_AFTER=700

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000
WORKER_URL=http://localhost:8300
WORKER_TOKEN=
ARTIFACTS_PATH=/artifacts
MEDIA_VIDEOS_PATH=/media/videos
MEDIA_UPLOADS_PATH=/media/uploads

# Image sidecar on the host (shared with the giftcard/CookCam stacks)
AI_IMAGE_SERVICE_BASE_URL=http://172.17.0.1:18790
AI_IMAGE_SERVICE_TOKEN=
AI_IMAGE_QUALITY=medium
OPENCLAW_HOOK_URL=
OPENCLAW_HOOK_TOKEN=

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@resend.codemenschen.at
MAIL_FROM_NAME=Appwerk
ADMIN_EMAIL=

# Ad platforms — campaigns run on Codemenschen's OWN accounts, customer pays the budget.
# Empty => that platform is unavailable (no error). Meta works with a System User token;
# Google needs a developer token that Google approves by hand.
META_ADS_TOKEN=
META_ADS_ACCOUNT_ID=
META_ADS_PAGE_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
